# ==============================================================================
# ObsidianMind - Environment Configuration
# ==============================================================================

# Server Port (Defaults to 8000 if omitted)
PORT=8000

# LLM Provider Configuration
# Supported providers: "google", "openai", "groq", "ollama"
LLM_PROVIDER=google

# API Keys (Provide at least one key matching your LLM_PROVIDER)
GOOGLE_API_KEY=your_google_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# LLM Model Name (Optional, sensible defaults applied automatically)
# Google: gemini-3.5-flash-lite (default/fast), gemini-3.5-flash, gemini-3.6-flash
# OpenAI: gpt-4o-mini, gpt-4o
# Groq: llama-3.3-70b-versatile, llama-3.1-8b-instant
# Ollama: llama3, mistral
LLM_MODEL=gemini-3.5-flash-lite
LLM_TEMPERATURE=0.2

# Embedding Model Configuration
# Supported providers: "huggingface", "google", "openai"
# Default is "huggingface" using "all-MiniLM-L6-v2" (100% free, local, fast, no API key needed)
EMBEDDING_PROVIDER=huggingface
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Vector Database Configuration
CHROMA_PERSIST_DIRECTORY=./chroma_db
CHROMA_COLLECTION_NAME=obsidian_vault

# RAG Ingestion & Chunking Parameters
CHUNK_SIZE=600
CHUNK_OVERLAP=100

# Retrieval Parameters
RETRIEVER_TOP_K=4
RETRIEVER_SCORE_THRESHOLD=0.35

# Router Configuration
ROUTER_MODEL=gemini-3.5-flash-lite
